# ─────────────────────────────────────────────────────────────
# Sugar & Bloom Cake Studio — environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (Railway Postgres) -----------------------------------------
# Railway provides this automatically when you add a Postgres plugin.
# Locally you can point it at any Postgres 14+ instance.
DATABASE_URL="postgresql://user:password@localhost:5432/bakery"
# Set to "disable" to turn off TLS (e.g. Railway's private network / local docker).
# Leave unset to let the driver negotiate TLS ("prefer").
DATABASE_SSL=

# --- Site --------------------------------------------------------------------
# Public origin of the deployed site. Used to build PayHere return/notify URLs,
# canonical/OG metadata, sitemap, and the Server Action CSRF allow-list.
# MUST equal the domain approved in PayHere. Inlined at BUILD time — redeploy
# after changing it. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Stable key so encrypted Server Action payloads survive redeploys / multiple
# Railway instances. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional for a single always-on instance; recommended in production.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Admin login -----------------------------------------------------------
# The dashboard admin account. Created/updated automatically on `npm run db:seed`.
ADMIN_EMAIL="owner@sugarandbloom.lk"
ADMIN_PASSWORD="change-me-please"
# Long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# --- Storefront settings -------------------------------------------------
# Currency is LKR. Delivery fee + free-delivery threshold are in whole rupees.
DELIVERY_FEE_LKR="600"
FREE_DELIVERY_OVER_LKR="15000"
# Minimum lead time (days) before a cake can be collected/delivered.
DEFAULT_LEAD_TIME_DAYS="2"

# --- File uploads --------------------------------------------------------
# Where product images uploaded from the admin are stored on disk.
# On Railway, mount a volume and set this to the mount path, e.g. /data/uploads
UPLOAD_DIR="./uploads"

# --- Reporting -----------------------------------------------------------
# Timezone the KPI dashboard cuts its month boundaries in. Defaults to
# Asia/Colombo; set it if the bakery reports on another calendar.
REPORT_TIMEZONE="Asia/Colombo"

# --- PayHere payment gateway (https://www.payhere.lk) ------------------
# Leave PAYHERE_MERCHANT_ID blank to run without online payment
# (orders fall back to "pay on collection / bank transfer").
#
# The SECRET must be the one shown for an APPROVED domain under
# Settings -> Domains & Credentials, and NEXT_PUBLIC_SITE_URL's host must equal
# that domain — otherwise checkout fails with "Unauthorized payment request".
# Sandbox auto-approves `localhost` only. See README -> PayHere setup.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# Only the exact word "live" switches to production; anything else = sandbox.
PAYHERE_MODE="sandbox"
# "1" logs the outgoing (non-secret) checkout fields — debugging aid.
PAYHERE_DEBUG=""
# Override just the notify (callback) URL. Must still be on an approved domain,
# so tunnels don't help in local dev — use scripts/fire-notify.mts instead.
PAYHERE_NOTIFY_URL=""
